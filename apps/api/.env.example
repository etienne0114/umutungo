# Set to false for local development without Supabase authentication
# Set to true for production deployment with Supabase authentication
AUTH_REQUIRED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://umutungo7.vercel.app,https://umutungo-five.vercel.app,https://umutungo-etienne0114s-projects.vercel.app
CORS_ORIGIN_REGEX=^https://umutungo-[a-z0-9-]+-etienne0114s-projects\.vercel\.app$
DATABASE_URL=postgresql://postgres.<project-ref>:<URL-encoded-password>@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
# Required only for administrator user management. Prefer the current secret key; keep server-side.
SUPABASE_SECRET_KEY=
# Legacy projects may use this compatible server-only key.
SUPABASE_SERVICE_ROLE_KEY=
