# Backend API URL (change to production URL when deploying)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to false for local development without Supabase authentication
# Set to true for production deployment with Supabase authentication
NEXT_PUBLIC_AUTH_REQUIRED=false

# Supabase configuration (required when AUTH_REQUIRED=true)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
